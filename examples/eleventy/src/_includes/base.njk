<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title or "Versioned Eleventy Example" }}</title>
    <style>
      body { font-family: Georgia, "Iowan Old Style", serif; max-width: 42rem; margin: 2rem auto; padding: 0 1rem; color: #2a2a2a; line-height: 1.6; }
      header a { color: #d31510; font-weight: 700; text-decoration: none; font-size: 1.15rem; }
      h1 { color: #d31510; font-family: system-ui, sans-serif; letter-spacing: -0.02em; }
      a { color: #d31510; }
      code { background: #fdebec; padding: 0.05rem 0.3rem; border-radius: 3px; }
    </style>
  </head>
  <body>
    <header><a href="{{ "/" | url }}">Versioned Eleventy Example</a></header>
    <main>{{ content | safe }}</main>
  </body>
</html>
